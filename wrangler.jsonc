{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-behavior-wrapped-judge",
  "main": "worker/phrase-judge-worker.mjs",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "LEADERBOARD_DB",
      "database_name": "agent-behavior-wrapped-leaderboard",
      "database_id": "f76276d2-1749-4d27-9aa3-da58949e66cb"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
