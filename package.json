{
  "name": "agent-behavior-wrapped",
  "version": "0.2.8",
  "description": "A private, local-first Wrapped report for Claude Code and Codex behavior.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Haoxing Du",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoxing-du/agent-behavior-wrapped.git"
  },
  "homepage": "https://github.com/haoxing-du/agent-behavior-wrapped#readme",
  "bugs": {
    "url": "https://github.com/haoxing-du/agent-behavior-wrapped/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude-code",
    "local-first",
    "behavior-analysis",
    "wrapped"
  ],
  "os": [
    "darwin"
  ],
  "files": [
    "dist/",
    "server/",
    "scripts/",
    "fixtures/",
    "README.md"
  ],
  "bin": {
    "behavior-wrapped": "server/cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/launcher.mjs",
    "demo": "node server/launcher.mjs --demo",
    "wrapped": "node server/cli.mjs",
    "analyze:phrases": "node scripts/mine-phrase-families.mjs",
    "review:interactions": "node scripts/review-interaction-tone.mjs",
    "review:workarounds": "node scripts/review-workaround-judge.mjs",
    "worker:dev": "npx --yes wrangler@4.86.0 dev",
    "worker:deploy": "npx --yes wrangler@4.86.0 deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "html-to-image": "^1.11.13",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  }
}
